--app-color-background-slate-elevated:#212121;}}</style><script nonce="">(() => {// Resolve OS appearance before styles paint without a blocking network request.
// Hydration preserves this seed until AppearanceProvider takes over.
/** @param {string} browserThemeCacheKey */
// oxlint-disable-next-line no-unused-vars -- The raw source is called by browser-theme-bootstrap.ts when constructing the inline script.
function initializeBrowserTheme(browserThemeCacheKey) {
  const root = document.documentElement;
  const preference = root.dataset.appearanceTheme;
  if (preference === "light" || preference === "dark") {
    root.dataset.theme = preference;
  } else {
    root.dataset.theme = window.matchMedia("(prefers-color-scheme: dark)")
      .matches
      ? "dark"
      : "light";
  }
  try {
    const themes = JSON.parse(
      window.localStorage.getItem(browserThemeCacheKey),
    );
    if (
      typeof themes?.css === "string" &&
      typeof themes.light === "boolean" &&
      typeof themes.dark === "boolean" &&
      // The origin-wide cache may belong to a different user or workspace.
      themes.accountId === (root.dataset.themeAccountId ?? null) &&
      themes.userId === (root.dataset.themeUserId ?? null)
    ) {
      document.querySelector("style[data-codex-app-themes]").textContent =
        themes.css;
      root.classList.toggle(
        "chatgpt-theme",
        themes[root.dataset.theme] === true,
      );
    }
  } catch {
    // Unavailable storage or an invalid cache leaves the default palette intact.
  }
}

initializeBrowserTheme("codex.browser.appThemes.v1");})();</script><script async="" src="./Daily GTA Gaming Blog_files/api.js"></script><link rel="stylesheet" type="text/css" href="./Daily GTA Gaming Blog_files/646698.84f08f9d91.css"><link rel="stylesheet" type="text/css" href="./Daily GTA Gaming Blog_files/761472.3887130207.css"><link rel="stylesheet" type="text/css" href="./Daily GTA Gaming Blog_files/638194.2a528d420a.css"><link rel="stylesheet" type="text/css" href="./Daily GTA Gaming Blog_files/561669.b2739c543c.css"><link rel="stylesheet" type="text/css" href="./Daily GTA Gaming Blog_files/146419.d944dab66c.css"><link rel="stylesheet" type="text/css" href="./Daily GTA Gaming Blog_files/39311.132fc7b02c.css"><link rel="stylesheet" type="text/css" href="./Daily GTA Gaming Blog_files/149402.de68aee0fb.css"><link rel="stylesheet" type="text/css" href="./Daily GTA Gaming Blog_files/52079.b4199cca4b.css"><link rel="stylesheet" type="text/css" href="./Daily GTA Gaming Blog_files/952734.c28a1f0121.css"><link rel="stylesheet" type="text/css" href="./Daily GTA Gaming Blog_files/254963.b49109b789.css"><link rel="stylesheet" type="text/css" href="./Daily GTA Gaming Blog_files/692751.54cfa0cdc5.css"><link rel="stylesheet" type="text/css" href="./Daily GTA Gaming Blog_files/818045.d7313b0c44.css"><link rel="stylesheet" type="text/css" href="./Daily GTA Gaming Blog_files/426505.02b0b4750d.css"><link rel="stylesheet" type="text/css" href="./Daily GTA Gaming Blog_files/415151.56ecb9b8cd.css"><link rel="stylesheet" type="text/css" href="./Daily GTA Gaming Blog_files/933161.c24ee27390.css"><meta http-equiv="origin-trial" content="AnY33Lstn7fSTXvj63Z4glPcRXtUukuM9rLN87JGOugFyfum9ckNUU3NYHeRLcp6TELT5wbCZih5SlHfumMbJAkAAABmeyJvcmlnaW4iOiJodHRwczovL2NoYXRncHQuY29tOjQ0MyIsImZlYXR1cmUiOiJXZWJSdGNTY3RwU25hcCIsImV4cGlyeSI6MTc5NDg3MzYwMCwiaXNTdWJkb21haW4iOnRydWV9"><link rel="stylesheet" type="text/css" href="./Daily GTA Gaming Blog_files/196211.efea808fba.css"><link rel="stylesheet" type="text/css" href="./Daily GTA Gaming Blog_files/116481.24d502530f.css"></head><body style="--text-document: 14px; --font-ui-size: 16px; --text-4xl: 36px; --text-3xl: 30px; --text-2xl: 24px; --text-xl: 20px; --text-lg: 18px; --text-base: 16px; --text-sm: 14px; --text-xs: 12px; --text-dynamic-isle-row: 14px; --text-heading-lg: 24px; --text-heading-app: 28px; --text-heading-md: 20px; --text-heading-sm: 18px;"><script nonce="">
(() => {
  const key = "oai-epic-native-launch";
  let launch = null;
  try { launch = JSON.parse(sessionStorage.getItem(key) || "null"); } catch {}
  function save() {
    try {
      if (launch) sessionStorage.setItem(key, JSON.stringify(launch));
      else sessionStorage.removeItem(key);
    } catch { launch = null; }
  }
  function capture() {
    const fragment = window.location.hash;
    if (!fragment) return;
    window.history.replaceState(window.history.state, "", "/epic/launch");
    const params = new URLSearchParams(fragment.slice(1));
    const snapshot = params.get("snapshot");
    const workspace = params.get("workspace_id");
    launch = Array.from(params).length === (workspace ? 2 : 1) && (!workspace || /^[A-Za-z0-9_-]{1,128}$/.test(workspace)) && snapshot &&
      /^[A-Za-z0-9_-]{80,16384}={0,2}$/.test(snapshot)
      ? { snapshot, workspace, id: crypto.randomUUID(), messageId: null, draftId: null } : null;
    save();
  }
  if (window.location.pathname === "/epic/launch") capture();
  function pending() {
    return launch && !launch.draftId && new URLSearchParams(window.location.search).get("epic_launch") === launch.id
      ? launch.snapshot : null;
  }
  window.__oaiEpicNativeLaunch = {
    get: () => launch?.snapshot ?? null,
    workspace: () => launch?.workspace ?? null,
    destination: () => launch ? "/?surface=work&epic_launch=" + launch.id : "/epic/launch",
    pending,
    ownsMessage: (messageId) => launch?.messageId === messageId,
    metadata: (messageId, draftId) => {
      if (!launch) return;
      if (draftId != null) {
        if (launch.draftId ? launch.draftId !== draftId : !pending()) return;
        launch.draftId = draftId;
      } else if (launch.messageId !== messageId) return;
      const changed = launch.messageId !== messageId;
      launch.messageId = messageId;
      save();
      if (changed) window.dispatchEvent(new Event("oai-epic-launch-changed"));
      return launch ? { epic_launch_snapshot: launch.snapshot } : undefined;
    },
    claimAttachmentNotification: (expected) => {
      if (!launch || launch.snapshot !== expected || launch.attachmentNotified) return false;
      launch.attachmentNotified = true;
      save();
      return true;
    },
    clear: (expected) => {
      if (launch?.snapshot === expected || launch?.messageId === expected) {
        launch = null;
        save();
        window.dispatchEvent(new Event("oai-epic-launch-changed"));
      }
    }
  };
  window.addEventListener("hashchange", () => {
    if (window.location.pathname !== "/epic/launch" || !window.location.hash) return;
    capture();
    window.dispatchEvent(new Event("oai-epic-launch-changed"));
  });
})();
