-sm leading-5 aspect-square shrink-0 items-center justify-center !px-0" aria-label="Preview"><span class="CompactSource-d7ZD01"><svg aria-hidden="true" height="16" viewBox="0 0 16 16" width="16" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-9df9ab66b410511a.svg#play-light-16" fill="currentColor"></use></svg></span><span class="LeadingSource-d79mNZ"><svg aria-hidden="true" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-9df9ab66b410511a.svg#play-light-20" fill="currentColor"></use></svg></span></button></span></div></div></div><div class="relative [container-type:inline-size]"><div class="InlineCodePane-EYx4bd w-full overflow-x-hidden"><div class="relative z-0 flex max-w-full Viewer-ALA646" dir="ltr"><div class="chatgpt-code-scrollport flex w-full items-stretch overscroll-x-contain Scrollport-kY3Nlm overflow-x-auto"><pre class="m-0 flex-1 cursor-text px-4 pb-3 font-mono text-size-code text-default md:px-5 ViewerContent-Cg8AgN pt-0 min-w-max whitespace-pre"><code><span>
